// MARK: - PlayPauseButtonView
struct PlayPauseButtonView: View {
    @Binding var isTimerRunning: Bool
    @Binding var hoursTotalSeconds: Int
    let tableHeaderColor: Color
    
    @State private var showControls: Bool = false
    
    private let buttonSize: CGFloat = 60 // dimensione circolare più piccola
    
    var body: some View {
        VStack {
            Spacer()
            
            HStack(spacing: 20) {
                // Bottone Pausa a sinistra
                if showControls {
                    Button(action: {
                        isTimerRunning = false
                    }) {
                        Image(systemName: "pause.fill")
                            .foregroundColor(.black)
                            .font(.title2)
                            .frame(width: buttonSize, height: buttonSize)
                            .background(tableHeaderColor)
                            .clipShape(Circle())
                    }
                }
                
                // Bottone Stop a destra
                if showControls {
                    Button(action: {
                        hoursTotalSeconds = 0
                        isTimerRunning = false
                        showControls = false
                    }) {
                        Image(systemName: "stop.fill")
                            .foregroundColor(.black)
                            .font(.title2)
                            .frame(width: buttonSize, height: buttonSize)
                            .background(tableHeaderColor)
                            .clipShape(Circle())
                    }
                }
                
                // Bottone Play iniziale (solo se showControls false)
                if !showControls {
                    Button(action: {
                        isTimerRunning = true
                        showControls = true
                    }) {
                        Image(systemName: "play.fill")
                            .foregroundColor(.black)
                            .font(.title2)
                            .frame(width: buttonSize, height: buttonSize)
                            .background(tableHeaderColor)
                            .clipShape(Circle())
                    }
                }
            }
            .padding(.bottom, 40)
        }
    }
}

