// MARK: - WeightChartView
struct WeightChartView: View {
    let workoutData: [WorkoutEntry]
    let tableHeaderColor: Color
    let accentTextColor: Color
    
    var body: some View {
        ZStack(alignment: .topTrailing) {
            Chart {
                ForEach(workoutData) { entry in
                    LineMark(
                        x: .value("Date", entry.date),
                        y: .value("Weight", entry.weight)
                    )
                    .foregroundStyle(tableHeaderColor)
                    
                    PointMark(
                        x: .value("Date", entry.date),
                        y: .value("Weight", entry.weight)
                    )
                    .foregroundStyle(.white)
                }
            }
            .chartYScale(domain: 60...80)
            .chartXAxis {
                let dates = workoutData.map { $0.date } + ["hourglass"]
                AxisMarks(values: dates) { value in
                    AxisGridLine().foregroundStyle(.white.opacity(0.4))
                    AxisTick().foregroundStyle(.white)
                    AxisValueLabel {
                        if let string = value.as(String.self) {
                            if string == "hourglass" {
                                Image(systemName: "hourglass").foregroundColor(.white)
                            } else {
                                Text(string).foregroundColor(.white)
                            }
                        }
                    }
                }
            }
            .chartYAxis {
                AxisMarks(position: .leading) { value in
                    AxisGridLine().foregroundStyle(.white.opacity(0.4))
                    AxisTick().foregroundStyle(.white)
                    AxisValueLabel {
                        if let double = value.as(Double.self) {
                            Text("\(Int(double))").foregroundColor(.white)
                        }
                    }
                }
            }
            .frame(width: 380, height: 260)
            
            // Bottone Personal Weight Progress
            Button(action: {}) {
                HStack(spacing: 6) {
                    Image(systemName: "chevron.down").foregroundColor(.white)
                    Text("Personal Weight Progress")
                        .font(.subheadline.bold())
                        .foregroundColor(accentTextColor)
                }
                .padding(8)
                .background(Color.black.opacity(0.4))
                .clipShape(RoundedRectangle(cornerRadius: 12))
                .padding([.top, .trailing], -4)
            }
        }
        .padding(.top, 8)
    }
}

