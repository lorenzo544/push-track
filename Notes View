import SwiftUI
import Charts

// MARK: - Modello dati
struct WorkoutEntry: Identifiable {
    let id = UUID()
    let date: String
    let weight: Double
}

// MARK: - NotesView principale
struct NotesView: View {
    @State private var hoursTotalSeconds = 0
    @State private var showSchedule = false
    @State private var showDiet = false
    @State private var showReminders = false
    @State private var isTimerRunning = false
    @State private var feelingText: String = ""
    @State private var showWorkout = false
    
    let workoutData: [WorkoutEntry] = [
        WorkoutEntry(date: "12/09", weight: 72.5),
        WorkoutEntry(date: "16/09", weight: 75.0),
        WorkoutEntry(date: "19/09", weight: 72.5)
    ]
    
    let timer = Timer.publish(every: 1, on: .main, in: .common).autoconnect()
    
    private let tableHeaderColor = Color(hex: "#FF9500")
    private let accentTextColor = Color(red: 200/255, green: 200/255, blue: 210/255)
    
    func hoursTimeFormatted(_ totalSeconds: Int) -> String {
        let hours = totalSeconds / 3600
        let minutes = (totalSeconds % 3600) / 60
        let seconds = totalSeconds % 60
        return String(format: "%02d:%02d:%02d", hours, minutes, seconds)
    }
    
    var body: some View {
        ZStack {
            Color(hex: "#121212").ignoresSafeArea()
            
            VStack(spacing: 0) {
                // TopBar fissa come CalendarView
                TopBarView(
                    hoursTotalSeconds: hoursTotalSeconds,
                    hoursTimeFormatted: hoursTimeFormatted,
                    tableHeaderColor: tableHeaderColor
                )
                
                // ScrollView con contenuto sotto la TopBar
                ScrollView {
                    VStack(spacing: 16) {
                        TodaysWorkoutButtonView(
                            showWorkout: $showWorkout,
                            tableHeaderColor: tableHeaderColor,
                            accentTextColor: accentTextColor
                        )

                        WeightChartView(
                            workoutData: workoutData,
                            tableHeaderColor: tableHeaderColor,
                            accentTextColor: accentTextColor
                        )
                        
                        ScheduleButtonView(
                            showSchedule: $showSchedule,
                            tableHeaderColor: tableHeaderColor
                        )
                        
                        DietRemindersView(
                            showDiet: $showDiet,
                            showReminders: $showReminders,
                            tableHeaderColor: tableHeaderColor
                        )
                        // Box "How do you feel today?"
                        VStack {
                            ZStack(alignment: .topLeading) {
                                if feelingText.isEmpty {
                                    Text("How do you feel today? ...")
                                        .foregroundColor(tableHeaderColor)
                                        .font(.headline.bold())                               .padding(.horizontal, 16)
                                    .padding(.top, 12)                       }
                                TextField("", text: $feelingText)
                                    .foregroundColor(.white)                     // testo digitato bianco
                                    .font(.headline.bold())                      // per uniformità
                                    .padding(16)
                                    .frame(maxWidth: .infinity, maxHeight: .infinity, alignment: .topLeading)
                            }
                            .frame(width: 380, height: 120)                        // stessa larghezza dei bottoni
                            .background(.ultraThinMaterial)
                            .clipShape(RoundedRectangle(cornerRadius: 16))
                        }

                        Spacer().frame(height: 120)
                    }
                    .padding(.top, 8) // piccolo margine sotto TopBar
                }
            }
            
            // Bottone Play/Pause fisso in basso
            PlayPauseButtonView(
                isTimerRunning: $isTimerRunning,
                hoursTotalSeconds: $hoursTotalSeconds,
                tableHeaderColor: tableHeaderColor
            )
        }
        .onReceive(timer) { _ in
            if isTimerRunning {
                hoursTotalSeconds += 1
            }
        }
    }
}

// MARK: - TopBarView identica a CalendarView
struct TopBarView: View {
    let hoursTotalSeconds: Int
    let hoursTimeFormatted: (Int) -> String
    let tableHeaderColor: Color
    
    var body: some View {
        HStack {
            HStack(spacing: 4) {
                Image(systemName: "figure.strengthtraining.traditional")
                    .foregroundColor(tableHeaderColor)
                    .font(.title3)
                Text(hoursTimeFormatted(hoursTotalSeconds))
                    .font(.title2.bold())
                    .foregroundColor(Color(hex: "#E5E5EA"))
            }
            Spacer()
            Button(action: {}) {
                Circle()
                    .fill(Color(hex: "#FF9500"))
                    .frame(width: 36, height: 36)
                    .overlay(
                        Image(systemName: "person.fill")
                            .foregroundColor(Color(hex: "#121212"))
                    )
            }
        }
        .padding(.horizontal)
        .frame(height: 60) // altezza fissa
        .background(Color(hex: "#121212"))
    }
}

// MARK: - TodaysWorkoutButtonView
struct TodaysWorkoutButtonView: View {
    @Binding var showWorkout: Bool
    let tableHeaderColor: Color
    let accentTextColor: Color
    var todaysWorkoutTitle: String {
        let date = Date()
        let formatter = DateFormatter()
        formatter.locale = Locale(identifier: "en_US_POSIX") // o "it_IT" per l'italiano
        formatter.dateFormat = "MMMM d, EEEE" // es: September 15, Monday
        return "\(formatter.string(from: date))'s Workout"
    }

    
    var body: some View {
        VStack(spacing: 8) {
            // Bottone Today's Workout
            Button(action: { withAnimation { showWorkout.toggle() } }) {
                HStack {
                    Text(todaysWorkoutTitle)
                        .foregroundColor(tableHeaderColor)
                        .font(.headline.bold())
                    Image(systemName: "chevron.down")
                        .rotationEffect(.degrees(showWorkout ? 180 : 0))
                        .foregroundColor(tableHeaderColor)
                    Spacer()
                 /*   Button(action: {}) {
                        Image(systemName: "pencil")
                            .foregroundColor(tableHeaderColor)
                    } */
                }
                .padding()
                .frame(width: 380)
                .background(.ultraThinMaterial)
                .clipShape(RoundedRectangle(cornerRadius: 16))
            }
            
            // Tabella degli esercizi (visibile solo se showWorkout == true)
            if showWorkout {
                ExercisesTableView(accentTextColor: accentTextColor)
            }
        }
    }
}
