import SwiftUI
import UIKit

// MARK: - ContentView con TabBar personalizzata
struct ContentView: View {
    init() {
        // Configurazione aspetto della Tab Bar
        let appearance = UITabBarAppearance()
        appearance.configureWithOpaqueBackground()
        
        // Sfondo della tab bar: colore scuro #121212
        appearance.backgroundColor = UIColor(hex: "#121212")
        
        // Colore icone e testo NON selezionati (grigio medio)
        appearance.stackedLayoutAppearance.normal.iconColor = UIColor(hex: "#B0B0B5")
        appearance.stackedLayoutAppearance.normal.titleTextAttributes = [.foregroundColor: UIColor(hex: "#B0B0B5")]
        
        // Colore icone e testo SELEZIONATI (arancione brillante)
        appearance.stackedLayoutAppearance.selected.iconColor = UIColor(hex: "#FF9500")
        appearance.stackedLayoutAppearance.selected.titleTextAttributes = [.foregroundColor: UIColor(hex: "#FF9500")]
        
        // Applicazione dell'aspetto a tutte le tab bar
        UITabBar.appearance().standardAppearance = appearance
        UITabBar.appearance().scrollEdgeAppearance = appearance
    }
    
    var body: some View {
        TabView {
            // Primo tab - Notes (icona manubrio)
            NotesView()
                .tabItem {
                    Image(systemName: "dumbbell")   // icona manubrio
                    Text("Notes")                   // etichetta sotto icona
